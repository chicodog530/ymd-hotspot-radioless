# Keep scripts/source on Unix line endings even when contributors use Windows.
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.env text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary artwork
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
